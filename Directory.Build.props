<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props - применяется ко всем C# проектам в src/.
  Здесь фиксируются общие настройки релизной версии 1.1.0 и copyright,
  которые автоматически наследуются всеми .csproj в репозитории.
-->
<Project>

  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <!-- Убирает длинный Git-хэш из InformationalVersion, чтобы окно About
         показывало чистую "1.1.0" без суффикса "+sha.hashgit" -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>AmdPanel</Company>
    <Product>AmdPanel</Product>
    <Copyright>Copyright (c) 2026 Kanzy-dev</Copyright>
    <Authors>Kanzy-dev</Authors>
    <RepositoryUrl>https://github.com/Kanzy-dev/AmdPanel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Kanzy-dev/AmdPanel</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
