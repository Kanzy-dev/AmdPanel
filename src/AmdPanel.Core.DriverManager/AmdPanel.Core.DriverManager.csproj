<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AmdPanel.Core.DriverManager</RootNamespace>
    <AssemblyName>AmdPanel.Core.DriverManager</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>AmdPanel</Company>
    <Product>AmdPanel</Product>
    <Copyright>Copyright (c) 2026 AmdPanel contributors</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.37.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmdPanel.Core.Hardware\AmdPanel.Core.Hardware.csproj" />
    <ProjectReference Include="..\AmdPanel.Core.Profiles\AmdPanel.Core.Profiles.csproj" />
  </ItemGroup>
</Project>
