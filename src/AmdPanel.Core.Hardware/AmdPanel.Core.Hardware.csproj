<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>AmdPanel.Core.Hardware</RootNamespace>
    <AssemblyName>AmdPanel.Core.Hardware</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>AmdPanel</Company>
    <Product>AmdPanel</Product>
    <Copyright>Copyright (c) 2026 AmdPanel contributors</Copyright>
    <Description>Core hardware layer: AMD ADLX + Win32 wrapper for AMD GPUs (Driver-Only scenario)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- InternalsVisibleTo: AmdPanel.Core.Profiles использует internal Win32.User32Display
       для gamma ramp (SetDeviceGammaRamp) и констант при применении профиля. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AmdPanel.Core.Profiles" />
  </ItemGroup>

  <!-- Копируем нативную сборку моста рядом с управляемой -->
  <ItemGroup>
    <None Include="..\..\build\NativeBridge\AmdPanel.NativeBridge.dll"
          Condition="Exists('..\..\build\NativeBridge\AmdPanel.NativeBridge.dll')">
      <Link>AmdPanel.NativeBridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
