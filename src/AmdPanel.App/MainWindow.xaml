<Window x:Class="AmdPanel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AmdPanel.App.ViewModels"
        xmlns:conv="clr-namespace:AmdPanel.App.Converters"
        Title="{DynamicResource app.title}"
        Height="720" Width="1100" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Window.Main}">
  <Window.Resources>
    <!-- HierarchicalDataTemplate: РЅРѕРґР° РЅР°РІРёРіР°С†РёРё -->
    <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}"
                              ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Nav.PageLabel}"
                   Text="{Binding Key, Converter={x:Static conv:NavKeyToTextConverter.Instance}}"/>
      </StackPanel>
    </HierarchicalDataTemplate>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <!-- ===== РЁР°РїРєР° ===== -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Header.Panel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Р›РѕРіРѕС‚РёРї + РЅР°Р·РІР°РЅРёРµ -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
          <TextBlock Text="AMD" FontWeight="Bold" FontSize="18"
                     Foreground="{StaticResource Brush.Accent}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource Header.Title}"
                     Text="{DynamicResource app.title}"/>
        </StackPanel>

        <!-- РЎРµР»РµРєС‚РѕСЂ Р°РєС‚РёРІРЅРѕРіРѕ GPU (Multi-GPU + iGPU support) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Header.Label}"
                     Text="{DynamicResource header.gpu}" Margin="0,0,8,0"/>
          <ComboBox Style="{StaticResource Combo.Selector}"
                    ItemsSource="{Binding Gpus}"
                    DisplayMemberPath="DisplayString"
                    SelectedItem="{Binding SelectedGpu, Mode=TwoWay}"/>
        </StackPanel>

        <!-- РЎРµР»РµРєС‚РѕСЂ СЏР·С‹РєР° -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Header.Label}"
                     Text="{DynamicResource header.language}" Margin="0,0,8,0"/>
          <ComboBox Style="{StaticResource Combo.Selector}" MinWidth="100"
                    SelectedIndex="0"
                    x:Name="LanguageCombo">
            <ComboBoxItem Content="EN"/>
            <ComboBoxItem Content="RU"/>
          </ComboBox>
        </StackPanel>

        <!-- РљРѕРЅС‚РµРєСЃС‚РЅРѕРµ РјРµРЅСЋ СЂР°Р±РѕС‡РµРіРѕ СЃС‚РѕР»Р° -->
        <CheckBox Grid.Column="4"
                  Content="{DynamicResource header.desktopContextMenu}"
                  IsChecked="{Binding ContextMenuEnabled, Mode=TwoWay}"/>

        <!-- РљРЅРѕРїРєР° "РџРµСЂРµСЃРєР°РЅРёСЂРѕРІР°С‚СЊ" -->
        <Button Grid.Column="5" Style="{StaticResource Button.Standard}"
                Margin="0,0,8,0"
                Command="{Binding RescanCommand}"
                Content="{DynamicResource header.rescan}"/>

        <!-- РљРЅРѕРїРєР° "Рћ РїСЂРѕРіСЂР°РјРјРµ" (v1.0.0) -->
        <Button Grid.Column="6" Style="{StaticResource Button.Standard}"
                Click="OnAboutClick"
                Content="About"/>
      </Grid>
    </Border>

    <!-- РџРѕРґ-С€Р°РїРєР°: СЃС‚Р°С‚СѓСЃ Driver-Only / Adrenalin -->
    <Border DockPanel.Dock="Top" Background="#FFFFFF"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1" Padding="12,4">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Header.Label}"
                   Text="{DynamicResource header.driverOnly}"
                   Visibility="{Binding IsDriverOnly, Converter={StaticResource Bool2Vis}}"/>
        <TextBlock Style="{StaticResource Header.Label}"
                   Text="{DynamicResource header.adrenalinInstalled}"
                   Visibility="{Binding IsDriverOnly, Converter={StaticResource Bool2Vis}, ConverterParameter=invert}"/>
        <TextBlock Margin="20,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   FontSize="12">
          <Run Text="ADLX"/>
          <Run Text=" "/>
          <Run Text="{Binding AdlxVersion, Mode=OneWay}"/>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- ===== РЎС‚СЂРѕРєР° СЃС‚Р°С‚СѓСЃР° ===== -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar.Panel}">
      <DockPanel LastChildFill="True">
        <!-- Apply / Cancel СЃРїСЂР°РІР° РѕС‚ СЃС‚Р°С‚СѓСЃР±Р°СЂР° -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,0,0">
          <Button Style="{StaticResource Button.Standard}" Margin="0,0,8,0"
                  Width="100"
                  Content="{DynamicResource actions.cancel}"
                  Command="{Binding CancelCommand}"
                  IsCancel="True"/>
          <Button Style="{StaticResource Button.Accent}"
                  Width="100"
                  Content="{DynamicResource actions.apply}"
                  Command="{Binding ApplyCommand}"
                  IsDefault="True"/>
        </StackPanel>
        <TextBlock Style="{StaticResource StatusBar.Text}"
                   Text="{Binding StatusText, Mode=OneWay}"/>
      </DockPanel>
    </Border>

    <!-- ===== РўРµР»Рѕ: TreeView | ContentControl ===== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Р”РµСЂРµРІРѕ РЅР°РІРёРіР°С†РёРё -->
      <TreeView Grid.Column="0" Style="{StaticResource Nav.Tree}"
                ItemsSource="{Binding Navigation}"
                SelectedItemChanged="OnNavSelectedChanged"
                x:Name="NavTree">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource Nav.TreeItem}">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="IsSelected" Value="{Binding IsInitiallySelected, Mode=OneWay}"/>
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.Border}"/>

      <!-- РђРєС‚РёРІРЅР°СЏ СЃС‚СЂР°РЅРёС†Р° -->
      <ContentControl Grid.Column="2"
                      Content="{Binding ActivePage}"
                      Margin="0"/>
    </Grid>
  </DockPanel>
</Window>

