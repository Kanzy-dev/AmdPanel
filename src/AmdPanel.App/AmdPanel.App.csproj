<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>AmdPanel.App</RootNamespace>
    <AssemblyName>AmdPanel</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Жёстко x64 - без AnyCPU, чтобы P/Invoke к AmdPanel.NativeBridge.dll
         всегда соответствовал битности amdadlx64.dll (System32 на x64 Windows). -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>AmdPanel</Company>
    <Product>AmdPanel</Product>
    <Copyright>Copyright (c) 2026 AmdPanel contributors</Copyright>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- v1.1.0: System.Drawing.Common для Icon.ExtractAssociatedIcon в InstalledAppsScanner -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmdPanel.Core.Hardware\AmdPanel.Core.Hardware.csproj" />
    <ProjectReference Include="..\AmdPanel.Core.Profiles\AmdPanel.Core.Profiles.csproj" />
    <ProjectReference Include="..\AmdPanel.Core.DriverManager\AmdPanel.Core.DriverManager.csproj" />
  </ItemGroup>

  <!-- Копирование нативного моста рядом с AmdPanel.exe при сборке -->
  <ItemGroup>
    <None Include="..\..\build\NativeBridge\AmdPanel.NativeBridge.dll"
          Condition="Exists('..\..\build\NativeBridge\AmdPanel.NativeBridge.dll')">
      <Link>lib\AmdPanel.NativeBridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\build\NativeBridge\AmdPanel.NativeBridge.pdb"
          Condition="Exists('..\..\build\NativeBridge\AmdPanel.NativeBridge.pdb')">
      <Link>lib\AmdPanel.NativeBridge.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Локализация: XAML-словари строк -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="Views\WatchdogDialog.xaml" />
    <Page Include="Views\AboutDialog.xaml" />
    <Page Include="Views\Pages\ThreeDSettingsPageView.xaml" />
    <Page Include="Views\Pages\DisplayResolutionPageView.xaml" />
    <Page Include="Views\Pages\DisplayColorPageView.xaml" />
    <Page Include="Views\Pages\FreeSyncPageView.xaml" />
    <Page Include="Views\Pages\ScalingPageView.xaml" />
    <Page Include="Views\Pages\DriverManagerPageView.xaml" />
    <Page Include="Views\Pages\PerformancePageView.xaml" />
    <Page Include="Themes\Styles.xaml" />
    <Page Include="Themes\Strings.en.xaml" />
    <Page Include="Themes\Strings.ru.xaml" />
  </ItemGroup>

</Project>
