<UserControl x:Class="AmdPanel.App.Views.Pages.ScalingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AmdPanel.App.Converters"
             Background="{StaticResource Brush.PanelBackground}">
  <UserControl.Resources>
    <conv:NavKeyToTextConverter x:Key="Key2Text"/>
  </UserControl.Resources>
  <DockPanel LastChildFill="True" Margin="16,12">

    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource Header.Title}"
               Text="{DynamicResource page.scaling.title}"
               Margin="0,0,0,12"/>

    <StackPanel Orientation="Vertical">

      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource scaling.mode}"/>
        <ComboBox Width="240"
                  ItemsSource="{Binding ScalingModes}"
                  SelectedItem="{Binding SelectedScalingMode, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding LabelKey, Converter={StaticResource Key2Text}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>

      <DockPanel Margin="0,8">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource scaling.device}"/>
        <ComboBox Width="240"
                  ItemsSource="{Binding ScalingDevices}"
                  SelectedIndex="{Binding SelectedScalingDevice, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Converter={StaticResource Key2Text}}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </DockPanel>

    </StackPanel>
  </DockPanel>
</UserControl>
