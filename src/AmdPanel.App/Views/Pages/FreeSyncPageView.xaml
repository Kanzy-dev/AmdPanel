<UserControl x:Class="AmdPanel.App.Views.Pages.FreeSyncPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.PanelBackground}">
  <DockPanel LastChildFill="True" Margin="16,12">

    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource Header.Title}"
               Text="{DynamicResource page.freesync.title}"
               Margin="0,0,0,12"/>

    <StackPanel Orientation="Vertical">
      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource fs.enable}"/>
        <CheckBox IsChecked="{Binding FreeSyncEnabled, Mode=TwoWay}"
                  IsEnabled="{Binding FreeSyncSupported}"
                  VerticalAlignment="Center"/>
      </DockPanel>

      <DockPanel Margin="0,12">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource fs.range}"/>
        <TextBlock Style="{StaticResource Form.ValueLabel}">
          <Run Text="{Binding FreeSyncMinHz, Mode=OneWay}"/>
          <Run Text=" – "/>
          <Run Text="{Binding FreeSyncMaxHz, Mode=OneWay}"/>
          <Run Text=" Hz"/>
        </TextBlock>
      </DockPanel>

      <TextBlock Style="{StaticResource Form.WarningText}"
                 Margin="0,16,0,0"
                 Text="{DynamicResource fs.notSupported}"
                 Visibility="{Binding FreeSyncSupported, Converter={StaticResource Bool2Vis}, ConverterParameter=invert}"/>
    </StackPanel>
  </DockPanel>
</UserControl>
