<UserControl x:Class="AmdPanel.App.Views.Pages.DisplayColorPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.PanelBackground}">
  <DockPanel LastChildFill="True" Margin="16,12">

    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource Header.Title}"
               Text="{DynamicResource page.color.title}"
               Margin="0,0,0,12"/>

    <StackPanel Orientation="Vertical">

      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource color.brightness}"/>
        <Slider Minimum="0" Maximum="100" Width="260"
                Value="{Binding Brightness, Mode=TwoWay}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Form.ValueLabel}"
                   Margin="8,0,0,0" Width="40"
                   Text="{Binding Brightness}"/>
      </DockPanel>

      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource color.contrast}"/>
        <Slider Minimum="0" Maximum="100" Width="260"
                Value="{Binding Contrast, Mode=TwoWay}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Form.ValueLabel}"
                   Margin="8,0,0,0" Width="40"
                   Text="{Binding Contrast}"/>
      </DockPanel>

      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource color.gamma}"/>
        <Slider Minimum="50" Maximum="200" Width="260"
                Value="{Binding Gamma, Mode=TwoWay}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Form.ValueLabel}"
                   Margin="8,0,0,0" Width="40"
                   Text="{Binding Gamma}"/>
      </DockPanel>

      <DockPanel Margin="0,4">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                   Width="280" Text="{DynamicResource color.saturation}"/>
        <Slider Minimum="0" Maximum="200" Width="260"
                Value="{Binding Saturation, Mode=TwoWay}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Form.ValueLabel}"
                   Margin="8,0,0,0" Width="40"
                   Text="{Binding Saturation}"/>
      </DockPanel>

      <Button Style="{StaticResource Button.Standard}" Margin="280,12,0,0"
              HorizontalAlignment="Left"
              Click="OnResetClick"
              Content="{DynamicResource color.reset}"/>

    </StackPanel>
  </DockPanel>
</UserControl>
