<UserControl x:Class="AmdPanel.App.Views.Pages.DriverManagerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AmdPanel.App.Converters"
             Background="{StaticResource Brush.PanelBackground}">
  <UserControl.Resources>
    <conv:NavKeyToTextConverter x:Key="Key2Text"/>
  </UserControl.Resources>
  <DockPanel LastChildFill="True" Margin="16,12">

    <TextBlock DockPanel.Dock="Top"
               Style="{StaticResource Header.Title}"
               Text="{DynamicResource page.driverManager.title}"
               Margin="0,0,0,12"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="Vertical">

        <!-- Текущий статус -->
        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.currentGpu}"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding GpuName}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.driverVersion}"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding DriverVersion}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.adlxVersion}"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding AdlxVersion}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="GPU Architecture"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding ArchitectureName}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="Driver Branch"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding DriverBranchName}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="Current Stage"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Foreground="{StaticResource Brush.Accent}"
                     Text="{Binding CurrentStage}"/>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.installMode}"/>
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Form.ValueLabel}">
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDriverOnly}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
            <Run>
              <Run.Text>
                <Binding Path="IsDriverOnly" Mode="OneWay"
                         Converter="{x:Static conv:DriverModeLabelConverter.Instance}"/>
              </Run.Text>
            </Run>
          </TextBlock>
        </DockPanel>

        <DockPanel Margin="0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.registryPath}"/>
          <TextBlock Style="{StaticResource Form.ValueLabel}"
                     Text="{Binding RegistryPath}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding RegistryPath}"/>
        </DockPanel>

        <!-- Источник драйвера -->
        <DockPanel Margin="0,12,0,4">
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Form.Label}"
                     Width="220" Text="{DynamicResource drv.sourceFile}"/>
          <TextBox Text="{Binding SelectedFilePath, Mode=TwoWay}"
                   Width="320" IsReadOnly="True"
                   VerticalAlignment="Center"/>
          <Button Style="{StaticResource Button.Standard}" Margin="8,0,0,0"
                  Click="OnBrowseClick"
                  Content="{DynamicResource actions.browse}"/>
        </DockPanel>

        <!-- Clean install checkbox -->
        <DockPanel Margin="220,4,0,4">
          <CheckBox IsChecked="{Binding CleanInstallChecked, Mode=TwoWay}"
                    VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource actions.cleanInstall}"
                       FontSize="13"/>
          </CheckBox>
        </DockPanel>

        <!-- Кнопки действий: Check updates / Install -->
        <StackPanel Orientation="Horizontal" Margin="220,12,0,4">
          <Button Style="{StaticResource Button.Standard}" Margin="0,0,8,0"
                  Click="OnCheckUpdatesClick"
                  Content="{DynamicResource actions.checkUpdates}"/>
          <Button Style="{StaticResource Button.Accent}"
                  Click="OnInstallClick"
                  Content="{DynamicResource actions.installClean}">
            <Button.ToolTip>
              <TextBlock Text="{DynamicResource actions.uacTooltip}"/>
            </Button.ToolTip>
          </Button>
        </StackPanel>

        <!-- Прогресс -->
        <DockPanel Margin="0,12">
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Form.Label}"
                     Text="{DynamicResource drv.installLog}"/>
          <ProgressBar Height="14" Minimum="0" Maximum="100" Margin="0,4,0,8"
                       Value="{Binding InstallProgress, Mode=OneWay}"/>
          <ListBox Height="180" ItemsSource="{Binding InstallLog}"
                   FontFamily="Consolas" FontSize="12"
                   BorderBrush="{StaticResource Brush.Border}"/>
        </DockPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
