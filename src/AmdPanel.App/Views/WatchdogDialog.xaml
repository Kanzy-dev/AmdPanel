<Window x:Class="AmdPanel.App.Views.WatchdogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource watchdog.title}"
        Height="240" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.Main}"
        ShowInTaskbar="False">
  <DockPanel LastChildFill="True" Margin="16">
    <!-- Текст -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock FontSize="14" FontWeight="SemiBold"
                 Text="{DynamicResource watchdog.title}"
                 Foreground="{StaticResource Brush.TextPrimary}"
                 TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageText" Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource Brush.TextSecondary}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Сравнение режимов -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource Form.Label}"
                 Text="{DynamicResource watchdog.previous}"/>
      <TextBlock Grid.Column="1" x:Name="PreviousText"
                 Style="{StaticResource Form.ValueLabel}"/>
      <TextBlock Grid.Column="3" Style="{StaticResource Form.Label}"
                 Text="{DynamicResource watchdog.new}"/>
      <TextBlock Grid.Column="4" x:Name="NewText"
                 Style="{StaticResource Form.ValueLabel}"
                 Foreground="{StaticResource Brush.Accent}"/>
    </Grid>

    <!-- Прогресс-бар -->
    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
      <ProgressBar x:Name="WatchdogProgress"
                   DockPanel.Dock="Top"
                   Height="6" Minimum="0" Maximum="100"
                   Margin="0,0,0,12"/>
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Standard}" Margin="0,0,8,0"
                Width="100" Click="OnNoClick"
                Content="{DynamicResource watchdog.no}"
                IsCancel="True"/>
        <Button Style="{StaticResource Button.Accent}"
                Width="100" Click="OnYesClick"
                Content="{DynamicResource watchdog.yes}"
                IsDefault="True"/>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</Window>
