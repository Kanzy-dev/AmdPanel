<Window x:Class="AmdPanel.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AmdPanel"
        Height="380" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Window.Main}"
        ShowInTaskbar="False">
  <DockPanel LastChildFill="True" Margin="24,20">

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="AMD" FontSize="36" FontWeight="Bold"
                 Foreground="{StaticResource Brush.Accent}"
                 VerticalAlignment="Center" Margin="0,0,12,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="AmdPanel" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextPrimary}"/>
        <TextBlock Text="Lightweight native control panel for AMD GPUs"
                   FontSize="12"
                   Foreground="{StaticResource Brush.TextSecondary}"/>
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Top"
            Background="{StaticResource Brush.PanelBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" Padding="16,12" CornerRadius="2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Form.Label}" Text="Version"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText"
                   Style="{StaticResource Form.ValueLabel}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Form.Label}" Text="ADLX SDK"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AdlxVersionText"
                   Style="{StaticResource Form.ValueLabel}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Form.Label}" Text="Driver Version"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DriverVersionText"
                   Style="{StaticResource Form.ValueLabel}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Form.Label}" Text="License"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Form.ValueLabel}" Text="MIT"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Form.Label}" Text="Repository"/>
        <TextBlock Grid.Row="4" Grid.Column="1">
          <Hyperlink NavigateUri="https://github.com/amdpanel/amdpanel"
                     Click="OnRepoClick">
            <Run Text="github.com/amdpanel/amdpanel"/>
          </Hyperlink>
        </TextBlock>

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Form.Label}" Text="Copyright"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Form.ValueLabel}"
                   Text="© 2026 AmdPanel contributors"/>
      </Grid>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource Button.Accent}" Width="100"
              Click="OnCloseClick" Content="OK" IsDefault="True"/>
    </StackPanel>

    <TextBlock Margin="0,12,0,0" FontSize="11"
               Foreground="{StaticResource Brush.TextSecondary}"
               TextWrapping="Wrap"
               Text="AMD ADLX SDK is licensed by Advanced Micro Devices, Inc. and is not part of the MIT-licensed AmdPanel codebase. See third_party/ADLXSDK/ADLX SDK License Agreement.pdf for terms."/>
  </DockPanel>
</Window>
