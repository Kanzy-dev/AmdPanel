<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AmdPanel.App.Converters">

  <!-- Глобальные экземпляры конвертеров, доступные из всех UserControl'ов -->
  <conv:BooleanToVisibilityConverter x:Key="Bool2Vis"/>
  <conv:InverseBooleanConverter x:Key="InvBool"/>
  <conv:CapabilityToEnabledConverter x:Key="Cap2Enabled"/>
  <conv:BandwidthWarningConverter x:Key="BwWarn2Vis"/>

  <!-- ===== Цветовая палитра (минималистичный NVIDIA Control Panel стиль) ===== -->
  <Color x:Key="Color.WindowBackground">#F8F8F8</Color>
  <Color x:Key="Color.HeaderBackground">#F5F5F5</Color>
  <Color x:Key="Color.PanelBackground">#FFFFFF</Color>
  <Color x:Key="Color.TreeBackground">#FFFFFF</Color>
  <Color x:Key="Color.TextPrimary">#2C2C2C</Color>
  <Color x:Key="Color.TextSecondary">#666666</Color>
  <Color x:Key="Color.Accent">#00A651</Color>           <!-- AMD green -->
  <Color x:Key="Color.AccentPressed">#008A44</Color>
  <Color x:Key="Color.Border">#E5E5E5</Color>
  <Color x:Key="Color.ButtonBackground">#F5F5F5</Color>
  <Color x:Key="Color.ButtonHover">#E8E8E8</Color>
  <Color x:Key="Color.Warning">#E67E00</Color>
  <Color x:Key="Color.DisabledText">#999999</Color>

  <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}"/>
  <SolidColorBrush x:Key="Brush.HeaderBackground" Color="{StaticResource Color.HeaderBackground}"/>
  <SolidColorBrush x:Key="Brush.PanelBackground" Color="{StaticResource Color.PanelBackground}"/>
  <SolidColorBrush x:Key="Brush.TreeBackground" Color="{StaticResource Color.TreeBackground}"/>
  <SolidColorBrush x:Key="Brush.Surface"          Color="#F5F6F7"/>       <!-- Light surface for control panels -->
  <SolidColorBrush x:Key="Brush.TextPrimary"     Color="{StaticResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary"   Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.Accent"          Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentPressed"   Color="{StaticResource Color.AccentPressed}"/>
  <SolidColorBrush x:Key="Brush.Border"          Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.ButtonBackground" Color="{StaticResource Color.ButtonBackground}"/>
  <SolidColorBrush x:Key="Brush.ButtonHover"     Color="{StaticResource Color.ButtonHover}"/>
  <SolidColorBrush x:Key="Brush.Warning"         Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.DisabledText"    Color="{StaticResource Color.DisabledText}"/>

  <!-- ===== Шрифты ===== -->
  <FontFamily x:Key="Font.Default">Segoe UI, Tahoma, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Header">Segoe UI Semibold, Segoe UI, Tahoma</FontFamily>

  <!-- ===== Стиль окна (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="Window.Main" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Brush.WindowBackground}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
    <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
  </Style>

  <!-- ===== Шапка (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="Header.Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="Header.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Header.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== TreeView (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="Nav.Tree" TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource Brush.TreeBackground}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Nav.TreeItem" TargetType="TreeViewItem">
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="Margin" Value="0,1"/>
  </Style>
  <Style x:Key="Nav.GroupLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="2,8,0,2"/>
  </Style>
  <Style x:Key="Nav.PageLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="14,2,2,2"/>
    <Setter Property="Padding" Value="0,2"/>
  </Style>

  <!-- ===== Кнопки (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="Button.Standard" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush.ButtonHover}"/>
              <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
              <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background" Value="#F0F0F0"/>
              <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.DisabledText}"/>
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Standard}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="20,8"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#008A44"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Таблица параметров (DataGrid "Параметр — Значение") ===== -->
  <Style x:Key="Params.DataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource Brush.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="RowHeight" Value="28"/>
    <Setter Property="ColumnHeaderHeight" Value="28"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="Params.ColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>

  <Style x:Key="Params.Cell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="Params.Row" TargetType="DataGridRow">
    <Setter Property="Height" Value="28"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E5F0E8"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Common form controls ===== -->
  <Style x:Key="Form.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style x:Key="Form.ValueLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Form.WarningText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>

  <!-- ===== Строка статуса (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="StatusBar.Panel" TargetType="Border">
    <Setter Property="Background" Value="#F8F8F8"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="StatusBar.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== ComboBox в шапке (минималистичный NVIDIA стиль) ===== -->
  <Style x:Key="Combo.Selector" TargetType="ComboBox">
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" 
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
            </Border>
            <Path Grid.Column="1" 
                  Data="M0,0 L1,0.5 L0,1 z"
                  Fill="{StaticResource Brush.TextSecondary}"
                  Margin="4,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
