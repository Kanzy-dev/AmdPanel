<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AmdPanel.App.Converters;assembly=AmdPanel">

  <!-- Глобальные экземпляры конвертеров, доступные из всех UserControl'ов -->
  <conv:BooleanToVisibilityConverter x:Key="Bool2Vis"/>
  <conv:InverseBooleanConverter x:Key="InvBool"/>
  <conv:CapabilityToEnabledConverter x:Key="Cap2Enabled"/>
  <conv:BandwidthWarningConverter x:Key="BwWarn2Vis"/>

  <!-- ===== Цветовая палитра (классический NVIDIA Control Panel стиль) ===== -->
  <Color x:Key="Color.WindowBackground">#F4F4F2</Color>
  <Color x:Key="Color.HeaderBackground">#E8E6E0</Color>
  <Color x:Key="Color.PanelBackground">#FFFFFF</Color>
  <Color x:Key="Color.TreeBackground">#FFFFFF</Color>
  <Color x:Key="Color.TextPrimary">#1F1F1F</Color>
  <Color x:Key="Color.TextSecondary">#5A5A5A</Color>
  <Color x:Key="Color.Accent">#0B6B3A</Color>           <!-- AMD green -->
  <Color x:Key="Color.AccentPressed">#074F2A</Color>
  <Color x:Key="Color.Border">#C8C5BE</Color>
  <Color x:Key="Color.ButtonBackground">#E1E0DC</Color>
  <Color x:Key="Color.ButtonHover">#D2D0CB</Color>
  <Color x:Key="Color.Warning">#B25B00</Color>
  <Color x:Key="Color.DisabledText">#999999</Color>

  <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}"/>
  <SolidColorBrush x:Key="Brush.HeaderBackground" Color="{StaticResource Color.HeaderBackground}"/>
  <SolidColorBrush x:Key="Brush.PanelBackground" Color="{StaticResource Color.PanelBackground}"/>
  <SolidColorBrush x:Key="Brush.TreeBackground" Color="{StaticResource Color.TreeBackground}"/>
  <SolidColorBrush x:Key="Brush.TextPrimary"     Color="{StaticResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary"   Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.Accent"          Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentPressed"   Color="{StaticResource Color.AccentPressed}"/>
  <SolidColorBrush x:Key="Brush.Border"          Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.ButtonBackground" Color="{StaticResource Color.ButtonBackground}"/>
  <SolidColorBrush x:Key="Brush.ButtonHover"     Color="{StaticResource Color.ButtonHover}"/>
  <SolidColorBrush x:Key="Brush.Warning"         Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.DisabledText"    Color="{StaticResource Color.DisabledText}"/>

  <!-- ===== Шрифты ===== -->
  <FontFamily x:Key="Font.Default">Segoe UI, Tahoma, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Header">Segoe UI Semibold, Segoe UI, Tahoma</FontFamily>

  <!-- ===== Стиль окна ===== -->
  <Style x:Key="Window.Main" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Brush.WindowBackground}"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>

  <!-- ===== Шапка ===== -->
  <Style x:Key="Header.Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style x:Key="Header.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Header.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== TreeView (классический вид) ===== -->
  <Style x:Key="Nav.Tree" TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource Brush.TreeBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="Nav.TreeItem" TargetType="TreeViewItem">
    <Setter Property="Padding" Value="2,3"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="IsExpanded" Value="True"/>
  </Style>
  <Style x:Key="Nav.GroupLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Header}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="2,8,0,2"/>
  </Style>
  <Style x:Key="Nav.PageLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Margin" Value="14,2,2,2"/>
    <Setter Property="Padding" Value="0,2"/>
  </Style>

  <!-- ===== Кнопки ===== -->
  <Style x:Key="Button.Standard" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Default}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Background" Value="{StaticResource Brush.ButtonBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush.ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.DisabledText}"/>
              <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Standard}">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Таблица параметров (DataGrid "Параметр — Значение") ===== -->
  <Style x:Key="Params.DataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource Brush.PanelBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="RowHeight" Value="28"/>
    <Setter Property="ColumnHeaderHeight" Value="28"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="Params.ColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>

  <Style x:Key="Params.Cell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="Params.Row" TargetType="DataGridRow">
    <Setter Property="Height" Value="28"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E5F0E8"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Common form controls ===== -->
  <Style x:Key="Form.Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>

  <Style x:Key="Form.ValueLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Form.WarningText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>

  <!-- ===== Строка статуса ===== -->
  <Style x:Key="StatusBar.Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.HeaderBackground}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="12,4"/>
  </Style>
  <Style x:Key="StatusBar.Text" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== ComboBox в шапке ===== -->
  <Style x:Key="Combo.Selector" TargetType="ComboBox">
    <Setter Property="MinWidth" Value="260"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>
